{
  "name": "scoot-with-friends",
  "version": "0.9.0-alpha.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/music-sync.mjs && vite --host 127.0.0.1",
    "build": "node scripts/music-sync.mjs && tsc --noEmit && vite build --outDir dist/client && node scripts/build-server.mjs",
    "preview": "vite preview --host 127.0.0.1 --outDir dist/client",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node tests/browser.mjs",
    "test:build2": "node tests/build2.browser.mjs",
    "test:build3": "node tests/build3.browser.mjs",
    "test:advanced": "node tests/advanced.browser.mjs",
    "test:memorial": "node tests/memorial.browser.mjs",
    "test:polish": "node tests/polish.browser.mjs",
    "test:editor": "node tests/editor.browser.mjs",
    "test:addendum": "node tests/addendum.browser.mjs",
    "test:riding": "node tests/riding-focus.browser.mjs",
    "test:visual": "node tests/visual-detail.browser.mjs",
    "package:windows": "powershell -ExecutionPolicy Bypass -File scripts/package-windows.ps1",
    "rooms": "tsx server/start-rooms.ts",
    "build:rooms": "tsc --noEmit -p tsconfig.rooms.json && node scripts/build-rooms.mjs",
    "start:rooms": "node dist/rooms/start.mjs",
    "music:sync": "node scripts/music-sync.mjs",
    "build:lan": "node scripts/build-lan.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.3",
    "@noble/hashes": "^2.0.1",
    "@node-rs/argon2": "^2.2.1",
    "three": "0.180.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "0.180.0",
    "@types/ws": "^8.18.1",
    "meshoptimizer": "0.22.0",
    "playwright": "1.55.1",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "vite": "^7.1.7"
  },
  "engines": {
    "node": "22.x"
  }
}
