# Browser riding requires no environment variables or credentials.
# Only the optional park publishing service needs this server-side secret.
PARK_PUBLISH_KEY=replace-only-in-your-host-secret-manager
# Never use a VITE_ prefix for secrets. Never ship owner-private.json.

# Optional private room service, separate from Sites. Browser URL is not a secret.
# VITE_ROOM_SERVER_URL=wss://your-approved-room-host
# Use ROOM_HOST=0.0.0.0 behind a public TLS reverse proxy; PORT is accepted when ROOM_PORT is unset.
ROOM_HOST=127.0.0.1
ROOM_PORT=8787
ROOM_CAPACITY=8
# Production must list the exact HTTPS game origin, e.g. https://scootwithfriends.online.
ROOM_ORIGINS=http://127.0.0.1:5182,http://localhost:5182
# Optional persistent friends. Production must use a mounted persistent volume.
# Without this, friend links reset when the room server restarts (shown in phone).
# ROOM_SOCIAL_FILE=/data/social.json
